{
  "version": 1,
  "local_roots": [
    "~/code"
  ],
  "max_depth": 3,
  "github_repos": [
    "godofecht/hobomaxxing"
  ],
  "jobs": [
    {
      "id": "repo-tests",
      "type": "command",
      "description": "Run Hobomaxxing unit tests locally",
      "enabled": false,
      "approval": "manual",
      "cwd": "~/code/hobomaxxing",
      "argv": ["python3", "-m", "unittest", "discover", "-s", "tests", "-v"],
      "timeout_seconds": 120,
      "min_interval_hours": 24,
      "impact": 3,
      "urgency": 2,
      "effort": 1,
      "risk": 1
    },
    {
      "id": "optional-github-workflow",
      "type": "github_dispatch",
      "description": "Manually trigger an explicitly approved GitHub workflow",
      "enabled": false,
      "approval": "manual",
      "repo": "godofecht/hobomaxxing",
      "workflow": "inventory.yml",
      "ref": "main",
      "inputs": {},
      "min_interval_hours": 24,
      "impact": 2,
      "urgency": 1,
      "effort": 1,
      "risk": 2
    }
  ]
}
